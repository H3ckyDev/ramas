---
/**
 * Process.astro — "Proceso" section
 * A 5-step horizontal (desktop) / vertical (mobile) timeline showing
 * how easy it is to install a RAMAS vending machine.
 */

const steps = [
  {
    number: "01",
    title: "Nos contactas",
    description:
      "Cuéntanos sobre tus necesidades y el espacio donde buscas incorporar un expendedor.",
  },
  {
    number: "02",
    title: "Evaluamos tu espacio",
    description:
      "Analizamos las características del lugar para ofrecer la mejor solución.",
  },
  {
    number: "03",
    title: "Proponemos una solución",
    description:
      "Te presentamos las opciones más adecuadas para tu espacio y presupuesto.",
  },
  {
    number: "04",
    title: "Coordinamos la instalación",
    description:
      "Nos encargamos de toda la logística e instalación sin costo para la comunidad.",
  },
  {
    number: "05",
    title: "Comienza a disfrutar",
    description:
      "Tu expendedor está operativo. Solo queda disfrutar de cada pausa.",
    featured: true,
  },
];
---

<section id="proceso" class="process-section" aria-labelledby="process-heading">
  <div class="process-container">
    <!-- Section header -->
    <header class="process-header reveal-fade-process">
      <h2 id="process-heading">
        Instalar tu expendedor es más fácil de lo que imaginas
      </h2>
      <p class="process-subtitle">
        En cinco sencillos pasos tendrás un expendedor completamente operativo en tu espacio.
      </p>
    </header>

    <!-- Timeline -->
    <ol class="timeline" role="list" aria-label="Pasos del proceso de instalación">
      {steps.map((step, i) => (
        <li
          class:list={[
            "timeline-step",
            { "timeline-step--featured": step.featured },
            "reveal-fade-process",
          ]}
          style={`--delay: ${i * 70}ms`}
        >
          {/* Number circle */}
          <div class="step-indicator" aria-hidden="true">
            <span class:list={["step-circle", { "step-circle--filled": step.featured }]}>
              {step.number}
            </span>
            {/* Connector line (not on last item) */}
            {i < steps.length - 1 && <span class="step-connector" />}
          </div>

          {/* Content */}
          <div class="step-body">
            <h3 class="step-title">{step.title}</h3>
            <p class="step-desc">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* ── Section ────────────────────────────────────── */
  .process-section {
    background:
      radial-gradient(ellipse 65% 55% at 20% 40%, rgba(232, 160, 191, 0.20) 0%, transparent 60%),
      radial-gradient(ellipse 50% 50% at 85% 75%, rgba(232, 160, 191, 0.15) 0%, transparent 55%),
      linear-gradient(180deg, #FDF0F5 0%, #FCE8F1 45%, #FDF0F5 85%, #FAF0F4 100%);
    padding: clamp(3.5rem, 5vw, 4.75rem) var(--section-padding-x, 1.5rem);
    overflow: hidden;
    position: relative;
  }

  .process-container {
    max-width: var(--max-width, 1200px);
    margin: 0 auto;
  }

  /* ── Header ─────────────────────────────────────── */
  .process-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto 2.5rem;
  }

  .process-header h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 3.5vw, 2.35rem);
    font-weight: 600;
    color: var(--color-text, #1A1A2E);
    line-height: 1.25;
    margin: 0 0 0.5rem;
  }

  .process-subtitle {
    font-family: var(--font-body);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary, #555566);
    margin: 0;
  }

  /* ── Timeline — Mobile-first (vertical) ─────────── */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .timeline-step {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    position: relative;
  }

  /* ── Indicator (circle + vertical connector) ────── */
  .step-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    position: relative;
  }

  .step-circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 2px solid var(--color-primary, #60816A);
    font-family: var(--font-heading);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary, #60816A);
    background: #ffffff;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);
    position: relative;
    z-index: 1;
    transition: background 0.3s ease, color 0.3s ease;
  }

  .step-circle--filled {
    background: var(--color-primary, #60816A);
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(96, 129, 106, 0.32);
  }

  /* Vertical connector (mobile) */
  .step-connector {
    display: block;
    width: 2px;
    flex: 1;
    min-height: 2rem;
    background: rgba(96, 129, 106, 0.25);
  }

  /* ── Step body ──────────────────────────────────── */
  .step-body {
    padding-bottom: 2.5rem;
    padding-top: 0.25rem;
  }

  .timeline-step:last-child .step-body {
    padding-bottom: 0;
  }

  @media (max-width: 599px) {
    .step-circle {
      width: 2.6rem;
      height: 2.6rem;
      font-size: 0.8rem;
    }

    .step-body {
      padding-bottom: 1.75rem;
    }

    .step-title {
      font-size: 1.05rem;
    }

    .step-desc {
      font-size: 0.85rem;
      line-height: 1.5;
    }
  }

  .step-title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text, #1A1A2E);
    margin: 0 0 0.4rem;
    line-height: 1.3;
  }

  .step-desc {
    font-family: var(--font-body);
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-text-secondary, #555566);
    margin: 0;
    max-width: 280px;
  }

  /* ── Desktop: horizontal timeline ───────────────── */
  @media (min-width: 900px) {
    .timeline {
      flex-direction: row;
      gap: 0;
    }

    .timeline-step {
      flex: 1;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 1.5rem;
    }

    /* Indicator row: circles + horizontal connector */
    .step-indicator {
      flex-direction: row;
      width: 100%;
      justify-content: center;
    }

    .step-connector {
      width: auto;
      height: 2px;
      min-height: unset;
      flex: 1;
      position: absolute;
      top: 50%;
      left: calc(50% + 1.5rem + 4px);
      right: calc(-50% + 1.5rem + 4px);
      transform: translateY(-50%);
      /* re-measure: connector spans between circles across columns */
    }

    /*
     * Horizontal connector approach:
     * Use a pseudo-element on each step (except last) that draws a line
     * from circle center to the next circle center.
     */
    .step-connector {
      display: none; /* hide the element-based connector on desktop */
    }

    /* Use a line behind the entire timeline row instead */
    .timeline::before {
      content: "";
      position: absolute;
      top: 1.5rem; /* center of 3rem circle */
      left: calc(10% + 1.5rem);
      right: calc(10% + 1.5rem);
      height: 2px;
      background: rgba(96, 129, 106, 0.25);
      z-index: 0;
    }

    .timeline {
      position: relative;
    }

    .step-body {
      padding-bottom: 0;
    }

    .step-desc {
      max-width: 200px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  /* ── Reveal animation ───────────────────────────── */
  .reveal-fade-process {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--delay, 0ms);
    will-change: opacity, transform;
  }

  .reveal-fade-process.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal-fade-process {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initProcessObserver(): void {
    const prefersReduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (prefersReduced) {
      document
        .querySelectorAll<HTMLElement>("#proceso .reveal-fade-process")
        .forEach((el) => {
          el.classList.add("is-visible");
        });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (entry.target as HTMLElement).classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.02, rootMargin: "0px 0px 60px 0px" }
    );

    document
      .querySelectorAll<HTMLElement>("#proceso .reveal-fade-process")
      .forEach((el) => {
        observer.observe(el);
      });
  }

  // Run on initial load and Astro page transitions
  initProcessObserver();
  document.addEventListener("astro:after-swap", initProcessObserver);
</script>
