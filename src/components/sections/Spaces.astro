---
/**
 * Spaces.astro — "Espacios donde instalar"
 * Muestra las 8 categorías solicitadas en un grid armónico con imágenes de alta calidad
 * y el diseño visual elegante de tarjetas con overlay oscuro y zoom al hover.
 */

const spaces = [
  {
    title: "Terminales de buses",
    description: "Disponibilidad 24/7 de bebidas y snacks para pasajeros en tránsito continuo.",
    image: "/images/terminal_de_buses.png",
  },
  {
    title: "Aeropuertos",
    description: "Atención rápida para viajeros en salas de espera y puertas de embarque.",
    image: "/images/aeropuerto.png",
  },
  {
    title: "Estadios",
    description: "Abastecimiento masivo para eventos deportivos y espectáculos de alta afluencia.",
    image: "/images/estadio.png",
  },
  {
    title: "Lugares de recreación deportiva",
    description: "Hidratación y nutrición funcional al alcance de deportistas y visitantes.",
    image: "/images/recreacion_deportiva.png",
  },
  {
    title: "Universidades",
    description: "Pausas de estudio ágiles para estudiantes, docentes y personal universitario.",
    image: "/images/universidad.png",
  },
  {
    title: "Malls",
    description: "Comodidad inmediata para compradores y personal de tiendas comerciales.",
    image: "/images/mall.png",
  },
  {
    title: "Oficinas corporativas",
    description: "Bienestar diario y snacks premium para mantener al equipo productivo.",
    image: "/images/oficinas_corporativas.png",
  },
  {
    title: "Espacios de alto tránsito",
    description: "Respuesta continua y confiable donde el flujo de personas nunca se detiene.",
    image: "/images/espacio_alto_transito.png",
  },
];
---

<section id="espacios" class="spaces-section" aria-labelledby="spaces-heading">
  <div id="expendedores" style="position: absolute; top: 0; left: 0; width: 0; height: 0; pointer-events: none;" aria-hidden="true"></div>
  <div class="spaces-container">
    <!-- Header minimalista: solo el título -->
    <header class="spaces-header reveal">
      <h2 id="spaces-heading">Espacios donde instalar</h2>
    </header>

    <!-- Grid de 8 espacios -->
    <div class="spaces-grid" role="list">
      {spaces.map((space, i) => (
        <div class="space-item reveal" role="listitem" style={`--delay: ${i * 60}ms;`}>
          <article class="space-card">
            <img
              src={space.image}
              alt={`${space.title} — espacio donde instalar expendedores RAMAS`}
              class="space-card__image"
              loading="lazy"
              decoding="async"
              width="600"
              height="400"
            />
            <div class="space-card__overlay" aria-hidden="true"></div>
            <div class="space-card__content">
              <h3 class="space-card__title">{space.title}</h3>
              <p class="space-card__desc">{space.description}</p>
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Section ────────────────────────────────────── */
  .spaces-section {
    background: var(--color-bg-white);
    padding-block: var(--section-padding, clamp(3.5rem, 5vw, 4.75rem));
  }

  .spaces-container {
    max-width: var(--container-max, 1200px);
    margin: 0 auto;
    padding-inline: var(--container-padding, 1.5rem);
  }

  /* ── Header Minimalista ─────────────────────────── */
  .spaces-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 2.25rem;
  }

  .spaces-header h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.85rem, 3.5vw, 2.35rem);
    font-weight: 600;
    color: var(--color-text, #1A1A2E);
    line-height: 1.25;
    margin: 0;
  }

  /* ── Grid de 8 Categorías ───────────────────────── */
  .spaces-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 600px) {
    .spaces-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .spaces-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.25rem;
    }
  }

  /* ── Wrapper para Reveal Suave ───────────────────────────── */
  .space-item {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* ── Card ────────────────────────────────────────── */
  .space-card {
    position: relative;
    border-radius: var(--radius-lg, 16px);
    overflow: hidden;
    min-height: 270px;
    height: 100%;
    width: 100%;
    cursor: default;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.05);
    transition: transform var(--duration-normal, 0.3s) var(--ease-out, ease),
                box-shadow var(--duration-normal, 0.3s) var(--ease-out, ease);
  }

  .space-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
  }

  @media (max-width: 599px) {
    .space-card {
      min-height: 210px;
    }

    .space-card__content {
      padding: 1.15rem 1rem;
    }

    .space-card__title {
      font-size: 1.05rem;
    }

    .space-card__desc {
      font-size: 0.82rem;
      line-height: 1.35;
    }
  }

  .space-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.45s ease-out;
  }

  .space-card:hover .space-card__image {
    transform: scale(1.06);
  }

  .space-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(26, 26, 46, 0.92) 0%,
      rgba(26, 26, 46, 0.5) 50%,
      rgba(26, 26, 46, 0.05) 100%
    );
    transition: opacity 0.3s ease;
  }

  .space-card:hover .space-card__overlay {
    opacity: 0.95;
  }

  .space-card__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.4rem 1.25rem;
    color: var(--color-text-on-dark, #ffffff);
  }

  .space-card__title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    color: #ffffff;
    margin: 0 0 0.35rem;
    line-height: 1.25;
  }

  .space-card__desc {
    font-family: var(--font-body);
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.4;
    margin: 0;
  }
</style>