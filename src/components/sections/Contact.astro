---
/**
 * Contact.astro — Centro de Contacto Directo 2026
 * Enfoque ágil sin fricción: WhatsApp con mensajes preconfigurados,
 * llamada telefónica directa y correo corporativo.
 */

const quickPrompts = [
  {
    label: 'Cotizar dispensador para mi empresa',
    message: 'Hola, me interesa solicitar una cotización de expendedores para mi empresa.',
  },
  {
    label: 'Consultar variedad de snacks y bebidas',
    message: 'Hola, me gustaría conocer el catálogo de snacks y bebidas disponibles para los expendedores.',
  },
  {
    label: 'Evaluar instalación en mi espacio',
    message: 'Hola, quisiera coordinar una evaluación técnica para instalar un dispensador en nuestras instalaciones.',
  },
  {
    label: 'Dudas sobre mantención y reposición',
    message: 'Hola, tengo dudas sobre el servicio de reposición y mantención de los expendedores.',
  },
];
---

<section id="contacto" class="contact" aria-labelledby="contact-heading">
  <div class="container">
    <!-- Header -->
    <div class="contact__header reveal">
      <span class="badge">Contacto directo</span>
      <h2 id="contact-heading">Sin formularios ni esperas innecesarias</h2>
      <p class="contact__subtitle">
        Conversemos directamente. Elige tu canal preferido y te responderemos de inmediato para resolver dudas o coordinar la instalación de tu dispensador.
      </p>
    </div>

    <!-- Direct Channels Grid -->
    <div class="contact__grid">
      <!-- ─── Primary Channel: WhatsApp Direct ─── -->
      <div class="contact__card contact__card--primary reveal reveal-delay-1">
        <div class="contact__card-badge">
          <span class="contact__status-dot" aria-hidden="true"></span>
          Respuesta inmediata
        </div>

        <div class="contact__card-icon contact__card-icon--wa" aria-hidden="true">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.198.297-.767.966-.94 1.164-.174.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.174-.297-.019-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51l-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12.05 21.785h-.013a9.65 9.65 0 0 1-4.92-1.348l-.353-.209-3.66.96.976-3.569-.23-.365a9.644 9.644 0 0 1-1.477-5.14c.002-5.334 4.342-9.674 9.679-9.674a9.62 9.62 0 0 1 6.84 2.834 9.62 9.62 0 0 1 2.83 6.842c-.003 5.334-4.343 9.674-9.679 9.674l.007-.005zM20.52 3.449C18.247 1.226 15.237 0 12.045 0 5.463 0 .104 5.334.101 11.893a11.86 11.86 0 0 0 1.587 5.946L0 24l6.305-1.654a11.88 11.88 0 0 0 5.683 1.448h.005c6.58 0 11.94-5.335 11.943-11.894a11.83 11.83 0 0 0-3.416-8.451z"/>
          </svg>
        </div>

        <h3>WhatsApp Comercial</h3>
        <p class="contact__card-text">
          Inicia un chat con nuestro equipo en un solo clic. Puedes seleccionar uno de los temas frecuentes para agilizar tu consulta:
        </p>

        <!-- Prompt chips for 1-click whatsapp prefilled text -->
        <div class="contact__chips">
          {quickPrompts.map((prompt) => (
            <a
              href={`https://wa.me/56949684141?text=${encodeURIComponent(prompt.message)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="contact__chip"
              title={`Iniciar chat sobre: ${prompt.label}`}
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="9 18 15 12 9 6" />
              </svg>
              <span>{prompt.label}</span>
            </a>
          ))}
        </div>

        <div class="contact__card-action">
          <a
            href="https://wa.me/56949684141?text=Hola%2C%20me%20gustar%C3%ADa%20solicitar%20informaci%C3%B3n%20sobre%20los%20expendedores%20RAMAS"
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--whatsapp btn--lg"
            aria-label="Abrir chat de WhatsApp con RAMAS"
          >
            Abrir WhatsApp (+56 9 4968 4141)
          </a>
        </div>
      </div>

      <!-- ─── Secondary Channels: Call + Email ─── -->
      <div class="contact__secondary-col">
        <!-- Call Card -->
        <div class="contact__card contact__card--secondary reveal reveal-delay-2">
          <div class="contact__card-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div>
            <span class="contact__channel-tag">Llamada telefónica</span>
            <h3 class="contact__number-heading">+56 9 4968 4141</h3>
            <p class="contact__card-text">
              Para atención personalizada inmediata o coordinación técnica en terreno.
            </p>
          </div>
          <a href="tel:+56949684141" class="btn btn--secondary btn--sm">
            Llamar directamente
          </a>
        </div>

        <!-- Email Card -->
        <div class="contact__card contact__card--secondary reveal reveal-delay-3">
          <div class="contact__card-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <div>
            <span class="contact__channel-tag">Correo corporativo</span>
            <h3 class="contact__number-heading">contacto@ramas.cl</h3>
            <p class="contact__card-text">
              Para licitaciones, requerimientos de compras o envío de planos y especificaciones.
            </p>
          </div>
          <a href="mailto:contacto@ramas.cl?subject=Consulta%20RAMAS%20-%20M%C3%A1quinas%20Expendedoras" class="btn btn--secondary btn--sm">
            Enviar correo
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section-padding);
    background-color: var(--color-bg-white);
    position: relative;
  }

  .contact__header {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    margin-bottom: 2rem;
  }

  .contact__header h2 {
    margin-block: 0.5rem 0.4rem;
  }

  .contact__subtitle {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
  }

  /* Grid Layout */
  .contact__grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: var(--space-2xl);
    align-items: stretch;
  }

  /* Card Base */
  .contact__card {
    background: #ffffff;
    border-radius: var(--radius-xl);
    padding: var(--space-2xl);
    border: 1px solid var(--color-border);
    transition: transform var(--duration-normal) var(--ease-out),
                box-shadow var(--duration-normal) var(--ease-out),
                border-color var(--duration-normal) var(--ease-out);
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .contact__card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
  }

  /* Featured WhatsApp Card */
  .contact__card--primary {
    background: linear-gradient(170deg, #FFFFFF 0%, #FDF0F5 100%);
    border: 2px solid var(--color-primary-light);
    box-shadow: var(--shadow-soft);
  }

  .contact__card-badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-primary-darker);
    background: #ffffff;
    border: 1px solid var(--color-primary-light);
    border-radius: 100px;
    padding: 0.35rem 0.85rem;
    margin-bottom: var(--space-lg);
  }

  .contact__status-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-accent-green);
    border-radius: 50%;
    box-shadow: 0 0 0 2px rgba(37, 211, 102, 0.25);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.5); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(37, 211, 102, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 211, 102, 0); }
  }

  .contact__card-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-md);
    background: var(--color-bg-rose);
    color: var(--color-primary-dark);
  }

  .contact__card-icon--wa {
    background: #E8F8EE;
    color: var(--color-accent-green);
  }

  .contact__card h3 {
    margin-bottom: var(--space-xs);
    font-size: var(--text-2xl);
  }

  .contact__card-text {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    margin-bottom: var(--space-lg);
  }

  /* Quick action chips */
  .contact__chips {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: var(--space-2xl);
  }

  .contact__chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    background: rgba(255, 255, 255, 0.85);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
  }

  .contact__chip svg {
    color: var(--color-primary-dark);
    flex-shrink: 0;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .contact__chip:hover {
    background: #ffffff;
    border-color: var(--color-primary-dark);
    color: var(--color-primary-darker);
    transform: translateX(4px);
  }

  .contact__chip:hover svg {
    transform: translateX(2px);
  }

  .contact__card-action {
    margin-top: auto;
  }

  .contact__card-action .btn {
    width: 100%;
  }

  /* Secondary Column */
  .contact__secondary-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .contact__card--secondary {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-md);
    align-items: center;
    padding: var(--space-xl);
  }

  .contact__card--secondary .contact__card-icon {
    grid-row: span 2;
    margin-bottom: 0;
  }

  .contact__card--secondary .btn {
    grid-column: 2;
    justify-self: start;
    margin-top: var(--space-xs);
  }

  .contact__channel-tag {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    color: var(--color-text-muted);
    font-weight: var(--weight-semibold);
    display: block;
    margin-bottom: 0.25rem;
  }

  .contact__number-heading {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-bottom: 0.35rem;
  }

  /* Responsive */
  @media (max-width: 960px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }
  }

  @media (max-width: 600px) {
    .contact__card {
      padding: var(--space-lg);
    }

    .contact__card--secondary {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .contact__card--secondary .contact__card-icon {
      grid-row: auto;
    }

    .contact__card--secondary .btn {
      grid-column: 1;
      width: 100%;
    }
  }
</style>
